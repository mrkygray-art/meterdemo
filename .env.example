# Copy this file to .env and fill in real TEST-MODE values.
# .env is git-ignored. Never put real keys in this file.

# Stripe secret key (Developers > API keys, test mode). Must start with sk_test_.
# (No publishable key needed: Checkout and the Portal are Stripe-hosted pages.)
STRIPE_SECRET_KEY=sk_test_replace_me

# (No price or meter IDs needed: the app finds prices by lookup key and meters by
#  event name. Create them once with: npm run setup:pricing)

# Webhook signing secret (from `stripe listen` locally, or the Dashboard endpoint in production)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# OpenAI key for the chat assistant (set a spending limit on it)
OPENAI_API_KEY=sk-replace_me

# Random long string used to sign the session cookie
COOKIE_SECRET=replace_with_a_long_random_string

# Optional: override the OpenAI model (default gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna
